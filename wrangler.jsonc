{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "matters-rss-service",
  "account_id": "757aaed316df635d8deb63859258808c",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/@*.xml", "/websub/*"]
  },
  "routes": [
    {
      "pattern": "rss.matters.town",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "matters-rss-service",
      "database_id": "18027637-b0ca-4aae-9e2f-aea4dfa587cc"
    }
  ],
  "vars": {
    "WEBSUB_DAILY_DELIVERY_LIMIT": "2500"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}

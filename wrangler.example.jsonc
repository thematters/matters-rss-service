{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "matters-rss-service",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "rss.matters.town/*",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "matters-rss-service",
      "database_id": "<fill-after-d1-create>"
    }
  ],
  "vars": {
    "WEBSUB_DAILY_DELIVERY_LIMIT": "2500"
  }
}
